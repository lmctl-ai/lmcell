p = _lmcode_ cli="lmcell" install="github:lmctl-ai/lmcell@latest";
let s=cell.sim(2).domain(0.0,10.0,0.0,10.0,10.0).substrate("food",0.0,0.0,1.0,-1.0);
s.cell_type("consumer").radius(1.0).exchange("food",2.0,0.0);
let r=s.seed("consumer",1,5.0,5.0).run(1.0,0.01);
cell.assert_close(r.profiles().get(0,2),cell.eval("exp(-2*(4*pi/3)/1000)"),0.000001);
end _lmcode_
savedsl(p, "build/uptake.dslb");
