mkdir("build/examples");
p = _lmcode_ cli="lmcell" install="github:lmctl-ai/lmcell@latest";
let s=cell.sim(1).domain(0.0,200.0,0.0,1.0,1.0).substrate("oxygen",1.0,0.01,0.0,1.0);let r=s.run(1000.0,0.01);cell.assert_close(r.profiles().get(10,2),cell.eval("exp(-1)"),0.0015);r.profiles().save_csv("build/examples/oxygen_penetration.csv");
end _lmcode_
savedsl(p, "build/oxygen_penetration.dslb");
r = system ${dsl_cli(p)} --dsl build/oxygen_penetration.dslb;
assert(r.code == 0);

mkdir("build/visual");
mkdir("images");
v = _lmcode_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/oxygen_penetration.png",900,520);
plot.cmd("set datafile separator ','");
plot.cmd("set border 3");
plot.cmd("set lmargin 14");
plot.cmd("set rmargin 4");
plot.cmd("set tics nomirror");
plot.cmd("set grid back lc rgb '#e4e9ef'");
plot.cmd("set key outside bottom center horizontal");
plot.cmd("set style line 1 lc rgb '#007f86' lw 3");
plot.cmd("set style line 2 lc rgb '#df6b38' lw 3");
plot.cmd("set style line 3 lc rgb '#5864a8' lw 3");
plot.cmd("set title 'Diffusion and decay limit oxygen penetration from both edges'");
plot.cmd("set xlabel 'x (micrometers)'");
plot.cmd("set ylabel 'Oxygen concentration (relative)'");
plot.cmd("plot 'build/examples/oxygen_penetration.csv' using 1:3 with lines ls 1 title 'BioFVM', cosh(0.1*(x-100))/cosh(9.95) with lines ls 2 dt 2 title 'Steady cosh profile'");
plot.close();
end _lmcode_
savedsl(v,"build/visual/oxygen_penetration.dslb");
r = system ${dsl_cli(v)} --dsl build/visual/oxygen_penetration.dslb;
assert(r.code==0);

println("wrote images/oxygen_penetration.png");
