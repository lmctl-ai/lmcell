mkdir("build/examples");
p = _dsl_ cli="lmcell" install="github:lmctl-ai/lmcell@latest";
let s=cell.sim(12345);s.cell_type("growing").cycle(0.3).radius(1.0);let r=s.seed("growing",2000,0.0,0.0).run(2.0,0.01);cell.assert_close(float(r.live()),cell.eval("2000*exp(0.6)"),190.0);r.counts().save_csv("build/examples/growth_birth.csv");
end _dsl_
savedsl(p, "build/growth_birth.dslb");
r = system ${dsl_cli(p)} --dsl build/growth_birth.dslb;
assert(r.code == 0);

mkdir("build/visual");
mkdir("images");
v = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/growth_birth.png",900,520);
plot.cmd("set datafile separator ','");
plot.cmd("set border 3");
plot.cmd("set lmargin 14");
plot.cmd("set rmargin 4");
plot.cmd("set tics nomirror");
plot.cmd("set grid back lc rgb '#e4e9ef'");
plot.cmd("set key outside top center horizontal");
plot.cmd("set style line 1 lc rgb '#007f86' lw 3");
plot.cmd("set style line 2 lc rgb '#df6b38' lw 3");
plot.cmd("set style line 3 lc rgb '#5864a8' lw 3");
plot.cmd("set title 'Stochastic cell division follows exponential growth'");
plot.cmd("set xlabel 'Time (minutes)'");
plot.cmd("set ylabel 'Live cells'");
plot.cmd("set xrange [0:2]");
plot.cmd("plot 'build/examples/growth_birth.csv' using 1:2 with lines ls 1 title 'Seeded agents', 2000*exp(0.3*x) with lines ls 2 dt 2 title 'Expected population'");
plot.close();
for(k in range(0,24)) {
plot.png("build/visual/growth_birth-frame-"+str(k)+".png",900,520);
plot.cmd("set arrow 1 from graph "+str(float(k)/23.0)+",0 to graph "+str(float(k)/23.0)+",1 nohead lc rgb '#df6b38' dt 2");
plot.cmd("replot");
plot.close();
}
end _dsl_
savedsl(v,"build/visual/growth_birth.dslb");
r = system ${dsl_cli(v)} --dsl build/visual/growth_birth.dslb;
assert(r.code==0);

println("wrote images/growth_birth.png");
