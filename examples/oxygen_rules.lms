mkdir("build/examples");
p = _dsl_ cli="lmcell" install="github:lmctl-ai/lmcell@latest";
let s=cell.sim(12345).substrate("oxygen",0.0,0.0,1.0,-1.0);
s.cell_type("sensitive").death(0.3).radius(1.0).rule("oxygen","decreases","apoptosis",1.0,2.0);
let r=s.seed("sensitive",5000,0.0,0.0).run(2.0,0.01);
cell.assert_close(float(r.live()),cell.eval("5000*exp(-0.3)"),120.0);
r.counts().save_csv("build/examples/oxygen_counts.csv");
r.cells().save_csv("build/examples/oxygen_cells.csv");
end _dsl_
savedsl(p, "build/oxygen_rules.dslb");
system ${dsl_cli(p)} --dsl build/oxygen_rules.dslb;
r = system bash examples/render-one.sh oxygen_rules;
println(r.stdout);
assert(r.code == 0);
