mkdir("build/examples");
p = _lmcode_ cli="lmcell" install="github:lmctl-ai/lmcell@latest";
let s=cell.sim(7).domain(0.0,60.0,0.0,40.0,10.0).substrate("oxygen",1.0,0.1,1.0,-1.0);
s.cell_type("cell").radius(1.0);
let r=s.seed("cell",1,30.0,20.0).run(1.0,0.01);
cell.assert_true(r.live()==1);
cell.assert_close(r.profiles().get(0,2),cell.eval("exp(-0.1)"),0.0001);
r.counts().save_csv("build/examples/tissue_decay_counts.csv");
r.profiles().save_csv("build/examples/tissue_decay_profiles.csv");
end _lmcode_
savedsl(p, "build/tissue_decay.dslb");
r = system ${dsl_cli(p)} --dsl build/tissue_decay.dslb;
if (r.code!=0) { println(r.stdout); println(r.stderr); }
assert(r.code==0);

mkdir("build/visual");
mkdir("images");
v = _lmcode_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/tissue_decay.png",900,520);
plot.cmd("set datafile separator ','");
plot.cmd("set border 3");
plot.cmd("set lmargin 14");
plot.cmd("set rmargin 4");
plot.cmd("set tics nomirror");
plot.cmd("set grid back lc rgb '#e4e9ef'");
plot.cmd("set key outside bottom center horizontal");
plot.cmd("set style line 1 lc rgb '#007f86' lw 3");
plot.cmd("set style line 2 lc rgb '#df6b38' lw 3");
plot.cmd("set style line 3 lc rgb '#5864a8' lw 3");
plot.cmd("set title 'A well-mixed substrate stays uniform as it decays'");
plot.cmd("set xlabel 'Voxel x position (micrometers)'");
plot.cmd("set ylabel 'Oxygen concentration (relative)'");
plot.cmd("set yrange [0:1.1]");
plot.cmd("plot 'build/examples/tissue_decay_profiles.csv' using 1:3 with points pt 7 ps 1.2 lc rgb '#007f86' title 'Voxel samples at t=1 min', exp(-0.1) with lines ls 2 dt 2 title 'Exact uniform decay'");
plot.close();
end _lmcode_
savedsl(v,"build/visual/tissue_decay.dslb");
r = system ${dsl_cli(v)} --dsl build/visual/tissue_decay.dslb;
assert(r.code==0);

println("wrote images/tissue_decay.png");
