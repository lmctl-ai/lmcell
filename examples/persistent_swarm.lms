mkdir("build/examples");
p = _dsl_ cli="lmcell" install="github:lmctl-ai/lmcell@latest";
let s=cell.sim(54321);s.cell_type("walker").motility(1.0,1.0).radius(1.0);let r=s.seed("walker",3000,0.0,0.0).run(20.0,0.05);cell.assert_true(r.live()==3000);r.cells().save_csv("build/examples/persistent_swarm.csv");
end _dsl_
savedsl(p, "build/persistent_swarm.dslb");
r = system ${dsl_cli(p)} --dsl build/persistent_swarm.dslb;
assert(r.code == 0);

mkdir("build/visual");
mkdir("images");
v = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/persistent_swarm.png",900,520);
plot.cmd("set datafile separator ','");
plot.cmd("set border 3");
plot.cmd("set lmargin 14");
plot.cmd("set rmargin 4");
plot.cmd("set tics nomirror");
plot.cmd("set grid back lc rgb '#e4e9ef'");
plot.cmd("set key outside top center horizontal");
plot.cmd("set style line 1 lc rgb '#007f86' lw 3");
plot.cmd("set style line 2 lc rgb '#df6b38' lw 3");
plot.cmd("set style line 3 lc rgb '#5864a8' lw 3");
plot.cmd("set title 'Persistent motility: 3000 cells after 20 minutes'");
plot.cmd("set xlabel 'x (micrometers)'");
plot.cmd("set ylabel 'y (micrometers)'");
plot.cmd("set size ratio -1");
plot.cmd("set xrange [-22:22]");
plot.cmd("set yrange [-22:22]");
plot.cmd("unset key");
plot.cmd("plot 'build/examples/persistent_swarm.csv' using 1:2 with points pt 7 ps 0.3 lc rgb '#007f86'");
plot.close();
end _dsl_
savedsl(v,"build/visual/persistent_swarm.dslb");
r = system ${dsl_cli(v)} --dsl build/visual/persistent_swarm.dslb;
assert(r.code==0);

println("wrote images/persistent_swarm.png");
