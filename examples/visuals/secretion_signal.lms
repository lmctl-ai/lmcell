mkdir("build/visual");
mkdir("docs/images");
v = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("docs/images/secretion_signal.png",900,520);
plot.cmd("set datafile separator ','");
plot.cmd("set border 3");
plot.cmd("set lmargin 14");
plot.cmd("set rmargin 4");
plot.cmd("set tics nomirror");
plot.cmd("set grid back lc rgb '#e4e9ef'");
plot.cmd("set key outside top center horizontal");
plot.cmd("set style line 1 lc rgb '#007f86' lw 3");
plot.cmd("set style line 2 lc rgb '#df6b38' lw 3");
plot.cmd("set style line 3 lc rgb '#5864a8' lw 3");
plot.cmd("set title 'Cell-secreted signal approaches saturation with increasing load'");
plot.cmd("set xlabel 'Cells per voxel'");
plot.cmd("set ylabel 'Signal concentration (relative)'");
plot.cmd("set xrange [-0.5:9.5]");
plot.cmd("set yrange [0:1.05]");
plot.cmd("set xtics 0,1,9");
plot.cmd("set boxwidth 0.7");
plot.cmd("set style fill solid 0.7");
plot.cmd("plot 'build/examples/secretion_signal.csv' using (($1-5)/10):3 with boxes lc rgb '#007f86' title 'BioFVM secretion', 1-exp(-2*(4*pi/3)/1000*20*x) with lines ls 2 title 'Continuum expectation'");
plot.close();
end _dsl_
savedsl(v,"build/visual/secretion_signal.dslb");
r = system ${dsl_cli(v)} --dsl build/visual/secretion_signal.dslb;
assert(r.code==0);
