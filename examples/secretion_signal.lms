mkdir("build/examples");
p = _dsl_ cli="lmcell" install="github:lmctl-ai/lmcell@latest";
let s=cell.sim(3).domain(0.0,100.0,0.0,10.0,10.0).substrate("signal",0.0,0.0,0.0,-1.0);s.cell_type("producer").radius(1.0).exchange("signal",0.0,2.0);for(i in range(0,10)){s.seed("producer",i,10.0*float(i)+5.0,5.0);}let r=s.run(20.0,0.05);cell.assert_close(r.profiles().get(9,2),cell.eval("1-exp(-2*(4*pi/3)/1000*9*20)"),0.001);r.profiles().save_csv("build/examples/secretion_signal.csv");
end _dsl_
savedsl(p, "build/secretion_signal.dslb");
r = system ${dsl_cli(p)} --dsl build/secretion_signal.dslb;
assert(r.code == 0);
r = system bash examples/render-one.sh secretion_signal;
println(r.stdout);
assert(r.code == 0);
